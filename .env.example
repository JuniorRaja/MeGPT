TTS_VOICE=prasanna
TTS_PROVIDER=fish
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=

# ── Next.js UI ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
